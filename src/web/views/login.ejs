<!DOCTYPE html>
<html>
  <head>
    <title>HEdClass</title>
    <link rel="stylesheet" href="/css/loginPage.css" />
  </head>
  <body>
    <div class="login-page-container">
      <div class="login-page-heading">
        <h1>Welcome to HEdClass</h1>
        <p>Student Classification System</p>
      </div>

      <div class="login-info">
        <h2>Academic Admin / Institutional Admin</h2>
      </div>

      <div class="login-page-form">
        <h2>Login to HEdClass</h2>
        <%- include("partials/flash") %>
        <form action="/login" method="POST">
          <label>Email:</label><br />
          <input type="email" name="email" value="<%= formData?.email || '' %>" required /><br /><br />

          <label>Password:</label><br />
          <input type="password" name="password" required /><br /><br />

          <button type="submit">Login</button>
        </form>
      </div>
    </div>
  </body>
</html>
