<!DOCTYPE html>
<html>
<head>
<title>Create Degree</title>
</head>

<body>

<h1>Create Degree</h1>

<form action="/admin/degrees/create" method="POST">

<label>Name</label><br>
<input type="text" name="name" required><br><br>

<label>Description</label><br>
<input type="text" name="description"><br><br>

<h3>Classification Rules</h3>

<label>Year 2 Weight (%)</label><br>
<input type="number" name="year2_weight" value="30" required><br><br>

<label>Year 3 Weight (%)</label><br>
<input type="number" name="year3_weight" value="70" required><br><br>

<button type="submit">Create Degree</button>

</form>

</body>
</html>