<!DOCTYPE html>
<html>
  <head>
    <title>Create Degree</title>
    <link rel="stylesheet" href="/css/degreeProgrammes.css" />
  </head>

  <body>
    <div class="container">
      <h1>Create Degree</h1>

      <div class="degree-form">
        <form action="/admin/degrees/create" method="POST">
          <label>Name</label>
          <input type="text" name="name" required />

          <label>Description</label>
          <input type="text" name="description" />

          <h3>Classification Rules</h3>

          <label>Year 2 Weight (%)</label>
          <input type="number" name="year2_weight" value="30" required />

          <label>Year 3 Weight (%)</label>
          <input type="number" name="year3_weight" value="70" required />

          <button type="submit">Create Degree</button>
        </form>
      </div>
    </div>
  </body>
</html>
