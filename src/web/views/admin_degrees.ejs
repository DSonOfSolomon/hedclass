<!DOCTYPE html>
<html>
  <head>
    <title>Degrees</title>
    <link rel="stylesheet" href="/css/degreeProgrammes.css">
  </head>

  <body>
    <div class="container">
      <h1>Degrees/Programmes</h1>

      <a href="/admin/degrees/create" class="btn">Create Degree</a>

      <br /><br />

      <div class="degree-programmes">
        <% degrees.forEach(function(degree){ %>
        <div class="degree-row">
          <p><strong>ID:</strong> <%= degree.id %></p>
          <p><strong>Name:</strong> <%= degree.name %></p>
          <p><strong>Description:</strong> <%= degree.description %></p>

          <div class="actions">
            <a href="/admin/degrees/edit/<%= degree.id %>" class="edt-btn">Edit</a> 
            <a href="/admin/degrees/delete/<%= degree.id %>"
              onclick="return confirm('Are you sure you want to delete this programme? This action cannot be undone.')"
               class="dlt-btn">Delete</a>
          </div>
        </div>
        <% }) %> 
      </div>
    </div>
  </body>
</html>
