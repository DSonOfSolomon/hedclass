<!DOCTYPE html>
<html>
  <head>
    <title>Modules</title>
    <link rel="stylesheet" href="/css/modules.css" />
  </head>

  <body>
    <div class="modules-container">
      <h1>Modules</h1>
      <a href="/dashboard" class="btn">← Back to Dashboard</a>
      <a href="/modules/create" class="btn">+ Add Module</a>

      <form method="GET" action="/modules" class="search-bar">
        <input type="hidden" name="degree_id" value="<%= degreeId %>">
      
        <input
          type="text"
          name="search"
          placeholder="Search modules by name or year..."
          value="<%= typeof search !== 'undefined' ? search : '' %>"
        >
      
        <button type="submit">Search</button>
      
        <a href="/modules?degree_id=<%= degreeId %>" class="btn">Reset</a>
      </form>

      <div class="table-wrapper">
        <table>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Credits</th>
            <th>Year</th>
            <th>Degree</th>
            <th class="actions">Action</th>
          </tr>

          <% modules.forEach(function(module){ %>

          <tr>
            <td><%= module.id %></td>
            <td><%= module.name %></td>
            <td><%= module.credits %></td>
            <td><%= module.year %></td>
            <td><%= module.degree_name %></td>

            <td class="actions">
              <a href="/modules/edit/<%= module.id %>" class="btn small"
                >Edit</a
              >
              <a
                href="/modules/delete/<%= module.id %>"
                class="btn small danger"
                onclick="return confirm('Are you sure you want to delete this module? This action cannot be undone.')"
                >Delete</a
              >
            </td>
          </tr>

          <% }) %>
        </table>
      </div>
    </div>
  </body>
</html>
