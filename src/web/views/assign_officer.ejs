<!DOCTYPE html>
<html>
  <head>
    <title>Assign Officer to Degree</title>
    <link rel="stylesheet" href="/css/degreeProgrammes.css" />
  </head>

  <body>
    <div class="container">
      <h1>Assign Officer to Degree</h1>

      <div class="assign-form">
        <form action="/admin/assign" method="POST">
          <label>Select Officer</label>

          <select name="officer_id" required>
            <option value="" disabled selected>-- Select Officer --</option>

            <% officers.forEach(function(officer){ %>
            <option value="<%= officer.id %>"><%= officer.name %></option>
            <% }) %>
          </select>

          <label>Select Degree</label>

          <select name="degree_id" required>
            <option value="" disabled selected>-- Select Degree --</option>

            <% degrees.forEach(function(degree){ %>
            <option value="<%= degree.id %>"><%= degree.name %></option>
            <% }) %>
          </select>

          <div class="assign-btn">
            <button type="submit">Assign</button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
