<!DOCTYPE html>
<html>
  <head>
    <title>Override Classification</title>
    <link rel="stylesheet" href="/css/students.css">
  </head>

  <body>
    <div class="container">
      <%- include("partials/flash") %>
      <h1>Override Classification</h1>

      <div class="student-info">
        <p>Student: <%= student.name %></p>
        <p>System Classification: <%= student.classification %></p>
      </div>

      <form action="/students/override/<%= student.id %>" method="POST">
        <label>Override Classification</label>

        <select name="override_classification">
          <option>First Class Honours (1st)</option>
          <option>Upper Second Class Honours (2:1)</option>
          <option>Lower Second Class Honours (2:2)</option>
          <option>Third Class Honours</option>
          <option>Fail</option>
        </select>

        <label>Reason</label>

        <textarea name="override_reason" required></textarea>

        <button type="submit">Save Override</button>
      </form>
    </div>
  </body>
</html>
