<!DOCTYPE html>
<html>
  <head>
    <title>Create Officer</title>

    <link rel="stylesheet" href="/css/admin_officers.css" />
  </head>
  <body>
    <div class="ccofficer-container">
      <div class="officer-page-header">
        <h1>Create Classification Officer</h1>
      </div>

      <form action="/admin/officers/create" method="POST">
        <label>Name</label><br />
        <input type="text" name="name" required /><br /><br />

        <label>Email</label><br />
        <input type="email" name="email" required /><br /><br />

        <label>Password</label><br />
        <input type="password" name="password" required /><br /><br />

        <button type="submit">Create Officer</button>
      </form>
    </div>
  </body>
</html>
