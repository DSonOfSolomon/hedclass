<!DOCTYPE html>
<html>
  <head>
    <title>Students</title>
  </head>

  <body>
    <h1>Student Cohort</h1>

    <a href="/students/create">Add Student</a>

    <br /><br />

    <table border="1">
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Student Number</th>
        <th>Degree</th>
        <th>Classification</th>
        <th>Override</th>
        <th>Reason</th>
        <th>Action</th>
      </tr>

      <% students.forEach(function(student){ %>

      <tr>
        <td><%= student.id %></td>
        <td><%= student.name %></td>
        <td><%= student.student_number %></td>
        <td><%= student.degree_name %></td>

        <td><%= student.classification || "Not calculated" %></td>
        <td><%= student.override_classification || "-" %></td>
        
        <td><%= student.override_reason || "-" %></td>

        <td>
          <a href="/students/classify/<%= student.id %>">Run Classification</a>

          <a href="/students/override/<%= student.id %>">Override</a>       |

          <a href="/students/edit/<%= student.id %>">Edit</a>       |

          <a href="/students/delete/<%= student.id %>">Delete</a>

          
        </td>
      </tr>

      <% }) %>
    </table>
  </body>
</html>
