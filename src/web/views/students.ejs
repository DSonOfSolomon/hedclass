<!DOCTYPE html>
<html>
  <head>
    <title>Students</title>
    <link rel="stylesheet" href="/css/students.css" />
  </head>

  <body>
    <div class="student-container">
      <%- include("partials/flash") %>
      <h1>Student Cohort</h1>

      <a href="/dashboard" class="btn">← Back to Dashboard</a>
      <a href="/students/create" class="btn">+ Add Student</a>
      <a href="/students" class="btn">All Students</a>
      <a href="/students?filter=review" class="btn"> Needs Review Only</a>

      <form method="GET" action="/students" class="search-bar">
        <input 
          type="text" 
          name="search" 
          placeholder="Search by name or student number..."
          value="<%= typeof search !== 'undefined' ? search : '' %>"
        >
        <button type="submit">Search</button>

        <a href="/students" class="reset-btn">Reset</a>
      </form>

      <div class="table-wrapper">
        <table>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Student Number</th>
            <th>Degree</th>
            <th>Classification</th>
            <th>Override</th>
            <th>Reason</th>
            <th>Y2 Avg</th>
            <th>Y3 Avg</th>
            <th>Final Avg</th>
            <th>Rationale</th>
            <th>Actions</th>
          </tr>

          <% students.forEach(function(student){ %>
          <tr>
            <td><%= student.id %></td>
            <td><%= student.name %></td>
            <td><%= student.student_number %></td>
            <td><%= student.degree_name %></td>

            <td>
              <% if (student.override_classification) { %>
              <strong><%= student.override_classification %></strong>
              <br />
              <span class="override-note">
                (Overridden from <%= student.classification || "Not calculated"
                %>)
              </span>
              <% } else { %> <%= student.classification || "Not calculated" %>
              <% } %> <% if (student.needs_review) { %>
              <br />
              <span class="review-flag">⚠️ Needs Review</span>
              <% } %>
            </td>
            <td><%= student.override_classification || "-" %></td>
            <td><%= student.override_reason || "-" %></td>

            <td>
              <%= student.year2_average !== null && typeof student.year2_average !== "undefined"
                ? Number(student.year2_average).toFixed(2)
                : "-"
              %>
            </td>
            <td>
              <%= student.year3_average !== null && typeof student.year3_average !== "undefined"
                ? Number(student.year3_average).toFixed(2)
                : "-"
              %>
            </td>
            <td>
              <%= student.final_average !== null && typeof student.final_average !== "undefined"
                ? Number(student.final_average).toFixed(2)
                : "-"
              %>
            </td>

            <td class="rationale">
              <pre><%= student.rationale %></pre>
            </td>

            <td class="actions">
              <a href="/students/classify/<%= student.id %>" class="btn run"
                >Run</a
              >
              <a href="/students/override/<%= student.id %>" class="btn small"
                >Override</a
              >
              <a href="/students/edit/<%= student.id %>" class="btn small"
                >Edit</a
              >
              <a
                href="/students/delete/<%= student.id %>"
                class="btn small danger"
                onclick="return confirm('Are you sure you want to delete this student? This action cannot be undone.')"
                >Delete</a
              >
            </td>
          </tr>
          <% }) %>
        </table>
      </div>
    </div>
  </body>
</html>
