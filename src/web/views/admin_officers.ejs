<!DOCTYPE html>
<html>
  <head>
    <title>Classification Officers</title>
    <link rel="stylesheet" href="/css/admin_officers.css" />
  </head>
  <body>
    <div class="cofficer-container">
      <h1>Classification Officers</h1>

      <a href="/admin/dashboard" class="btn">← Back to Dashboard</a>
      <a href="/admin/officers/create" class="btn">+ Create New Officer</a>

      <br /><br />

      <div class="officer-list">
        <% officers.forEach(function(officer){ %>

        <div class="officer-row">
          <p><strong>ID:</strong> <%= officer.id %></p>
          <p><strong>Name:</strong> <%= officer.name %></p>
          <p><strong>Email:</strong> <%= officer.email %></p>

          <div class="actions">
            <a href="/admin/officers/edit/<%= officer.id %>" class="edit-btn"
              >Edit</a
            >
            <a
              href="/admin/officers/delete/<%= officer.id %>"
              class="delete-btn"
              onclick="return confirm('Are you sure you want to delete this officer? This action cannot be undone.')"
              >Delete</a
            >
          </div>
        </div>

        <% }) %>
      </div>
    </div>
  </body>
</html>
