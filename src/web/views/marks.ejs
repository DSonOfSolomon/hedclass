<!DOCTYPE html>
<html>
  <head>
    <title>Marks</title>
    <link rel="stylesheet" href="/css/marks.css">
  </head>

  <body>
    <div class="mark-container">
      <h1>Module Marks</h1>
      <a href="/dashboard" class="btn">← Back to Dashboard</a>
      <a href="/marks/create" class="btn">+ Add Mark</a>

      <div class="table-wrapper">
        <table>
          <tr>
            <th>Student</th>
            <th>Module</th>
            <th>Credits</th>
            <th>Mark</th>
            <th>Resit</th>
            <th class="actions">Action</th>
          </tr>

          <% marks.forEach(function(mark){ %>

          <tr>
            <td><%= mark.student_name %></td>
            <td><%= mark.module_name %></td>
            <td><%= mark.credits %></td>
            <td><%= mark.mark %></td>
            <td><%= mark.is_resit ? "Yes" : "No" %></td>

            <td class="actions">
              <a href="/marks/edit/<%= mark.id %>" class="btn small">Edit</a>
              <a href="/marks/delete/<%= mark.id %>"
                onclick="return confirm('Are you sure you want to delete this mark? This action cannot be undone.')"
                 class="btn small danger"
                >Delete</a
              >
            </td>
          </tr>

          <% }) %>
        </table>
      </div>
    </div>
  </body>
</html>
