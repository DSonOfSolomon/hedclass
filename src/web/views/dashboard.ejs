<!DOCTYPE html>
<html>
  <head>
    <title>HEdClass</title>
    <link rel="stylesheet" href="/css/classificationOfficerPage.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  </head>

  <body>
    <div class="navbar">
      <button class="menu-btn" onclick="toggleDrawer()">☰</button>

      <h2>HEdClass</h2>

      <div class="profile" onclick="toggleProfileModal()">
        <div class="avatar">👤</div>
      </div>
    </div>

    <div id="overlay" class="overlay" onclick="closeDrawer()"></div>

    <div id="drawer" class="drawer">
      <h3>Officer Actions</h3>
      <a href="/students">Students</a>
      <a href="/modules">Modules</a>
      <a href="/marks">Marks</a>
    </div>

    <div id="profileModal" class="profile-modal">
      <div class="modal-content">
        <div class="avatar large">👤</div>
        <h3><%= user.name %></h3>
        <p>Classification Officer</p>
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </div>

    <div class="container">
      <h1>Dashboard</h1>

      <div class="summary">
        <div class="card">Students<br /><strong><%= students %></strong></div>
        <div class="card">Programmes<br /><strong><%= degrees %></strong></div>
        <div class="card">Modules<br /><strong><%= modules %></strong></div>
      </div>

      <h2>Programme Summary</h2>

      <div class="table-card">
        <table>
          <tr>
            <th>Programme</th>
            <th>Students</th>
          </tr>

          <% programmes.forEach(function(p){ %>
          <tr>
            <td><%= p.name %></td>
            <td><%= p.count %></td>
          </tr>
          <% }) %>
        </table>
      </div>

      <h2>Classification Distribution</h2>

      <div class="table-card">
        <table>
          <tr>
            <th>Classification</th>
            <th>Count</th>
          </tr>

          <% classifications.forEach(function(row){ %>
          <tr>
            <td><%= row.classification %></td>
            <td><%= row.count %></td>
          </tr>
          <% }) %>
        </table>
      </div>

      <h3>Classification Graph</h3>

      <div class="chart-box">
        <canvas id="classificationChart"></canvas>
      </div>
    </div>

    <script>

                function toggleDrawer() {
                  document.getElementById("drawer").classList.toggle("open");
                  document.getElementById("overlay").classList.toggle("show");
                }

                function closeDrawer() {
                  document.getElementById("drawer").classList.remove("open");
                  document.getElementById("overlay").classList.remove("show");
                }


                function toggleProfileModal() {
                  document.getElementById("profileModal").classList.toggle("show");
                }


                document.getElementById("profileModal").addEventListener("click", function(e) {
                  if (e.target === this) {
                    this.classList.remove("show");
                  }
                });


                const labels = <%- JSON.stringify(classifications.map(c => c.classification)) %>;
                const data = <%- JSON.stringify(classifications.map(c => c.count)) %>;

                const ctx = document.getElementById('classificationChart');

                new Chart(ctx, {
                  type: 'bar',
                  data: {
                    labels: labels,
                    datasets: [{
                      label: 'Students',
                      data: data,
                      backgroundColor: [
                        '#4CAF50','#2196F3','#FFC107','#FF5722','#9E9E9E'
                      ]
                    }]
                  },
                  options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                display: false
              }
            },
            scales: {
        y: {
          beginAtZero: true,
          ticks: {
            stepSize: 1,
            precision: 0 // ensures no decimals
          }
        }
      }

          }
                });
    </script>

    <script>
      document.addEventListener("click", function (e) {
        const modal = document.getElementById("profileModal");
        const profile = document.querySelector(".profile");

        if (!profile.contains(e.target) && !modal.contains(e.target)) {
          modal.classList.remove("show");
        }
      });
    </script>
   <div class="export-container">
    <form action="/export" method="GET">
      <select name="degree_id" required>
        <option value="">-- Select Programme --</option>
        <% assignedDegrees.forEach(function(degree){ %>
          <option value="<%= degree.id %>"><%= degree.name %></option>
        <% }) %>
      </select>
  
      <button type="submit" class="btn export-btn">
        Export Programme CSV
      </button>
    </form>
  </div>
  </body>
</html>
