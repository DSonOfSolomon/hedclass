<!DOCTYPE html>
<html>
<head>
<title>Edit Mark</title>
<link rel="stylesheet" href="/css/marks.css">
</head>
<body>

    <div class="edit-container">
  
      <h1>Edit Mark</h1>
  
      <form action="/marks/update/<%= mark.id %>" method="POST">
  
        <label>Student</label>
        <select name="student_id">
          <% students.forEach(function(student){ %>
            <option value="<%= student.id %>" <%= mark.student_id == student.id ? "selected" : "" %>>
              <%= student.name %>
            </option>
          <% }) %>
        </select>
  
        <label>Module</label>
        <select name="module_id">
          <% modules.forEach(function(module){ %>
            <option value="<%= module.id %>" <%= mark.module_id == module.id ? "selected" : "" %>>
              <%= module.name %>
            </option>
          <% }) %>
        </select>
  
        <label>Mark</label>
        <input type="number" name="mark" value="<%= mark.mark %>" required>
  
        <div class="checkbox-group">
          <input type="checkbox" name="is_resit" id="resit" <%= mark.is_resit ? "checked" : "" %>>
          <label for="resit">Resit</label>
        </div>
  
        <button type="submit">Update Mark</button>
  
      </form>
  
    </div>
  
  </body>


</html>