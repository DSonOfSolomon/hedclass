<!DOCTYPE html>
<html>
  <head>
    <title>Add Mark</title>
    <link rel="stylesheet" href="/css/marks.css">
  </head>

  <body>
    <div class="add-container">
      <%- include("partials/flash") %>
      <h1>Add Module Mark</h1>

      <form action="/marks/create" method="POST">
        <label>Student</label>
        <select name="student_id">
          <% students.forEach(function(student){ %>
          <option value="<%= student.id %>"><%= student.name %></option>
          <% }) %>
        </select>

        <label>Module</label>
        <select name="module_id">
          <% modules.forEach(function(module){ %>
          <option value="<%= module.id %>"><%= module.name %></option>
          <% }) %>
        </select>

        <label>Mark</label>
        <input type="number" name="mark" required />

        <div class="checkbox-group">
          <input type="checkbox" name="is_resit" id="resit" />
          <label for="resit">Resit?</label>
        </div>

        <button type="submit">Save Mark</button>
      </form>
    </div>
  </body>
</html>
