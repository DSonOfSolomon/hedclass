<!DOCTYPE html>
<html>
<head>
<title>Edit Student</title>
<link rel="stylesheet" href="/css/students.css">
</head>

<body>

    <div class="edit-student-container">

<h1>Edit Student</h1>

<form action="/students/update/<%= student.id %>" method="POST">

<label>Name</label>
<input type="text" name="name" value="<%= student.name %>" required>

<label>Student Number</label>
<input type="text" name="student_number" value="<%= student.student_number %>" required>

<label>Degree</label>

<select name="degree_id">

<% degrees.forEach(function(degree){ %>

<option value="<%= degree.id %>" <%= student.degree_id == degree.id ? "selected" : "" %>>
<%= degree.name %>
</option>

<% }) %>

</select>



<button type="submit">Update Student</button>

</form>


    </div>


</body>
</html>